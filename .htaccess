<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (do this first)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Protect sensitive files and directories
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.github - [F,L]
    RewriteRule ^db/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^\.canonical/ - [F,L]
    RewriteRule ^\.archive/ - [F,L]
    RewriteRule ^cms/config\.php$ - [F,L]

    # Allow direct access to setup.php
    RewriteCond %{REQUEST_URI} ^/setup\.php$ [NC]
    RewriteRule ^ - [L]

    # Allow direct access to documentation files (markdown)
    RewriteCond %{REQUEST_URI} \.(md|txt)$ [NC]
    RewriteRule ^ - [L]

    # MPS API Engine routing - delegate to mps-api/index.php
    RewriteCond %{REQUEST_URI} ^/mps-api/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^mps-api/(.*)$ mps-api/index.php [L,QSA]

    # Redirect root to CMS
    RewriteCond %{REQUEST_URI} ^/?$ [OR]
    RewriteCond %{REQUEST_URI} ^/index\.php$
    RewriteRule ^ /cms/ [L,R=301]

    # No catch-all routing - let Apache handle normal file/directory access
    # Removed root index.php routing since we moved to cms/ directory

    # Additional file protection via FilesMatch
    <FilesMatch "(\.env.*|\.htaccess|composer\.(json|lock)|config\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    # Security headers
    Header always set Strict-TransportSecurity "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Allow CMS command center to embed debugger
    SetEnvIf Request_URI "^/cms/(panel-message-monitor|payload-debugger)\.php$" allow_iframe=1
    Header always set X-Frame-Options "SAMEORIGIN" env=allow_iframe

    # Remove server signature
    Header unset X-Powered-By
    ServerSignature Off
</IfModule>

# Disable directory listing
Options -Indexes

# Compress responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache control
<FilesMatch "\.(jpg|jpeg|png|gif|js|css|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# Extended timeout for cache refresh endpoint
<FilesMatch "refresh-cache-enhanced\.php$">
    php_value max_execution_time 3600
    php_value max_input_time 3600
    php_value memory_limit 1G
</FilesMatch>

# Protect database directory
<Directory "/home/resolut7/public_html/mpsm.resolutionsbydesign.us/db">
    Require all denied
    <FilesMatch "\.db$">
        Require all denied
    </FilesMatch>
</Directory>

# Error documents - use default Apache pages
# Removed custom error.php since it doesn't exist

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
