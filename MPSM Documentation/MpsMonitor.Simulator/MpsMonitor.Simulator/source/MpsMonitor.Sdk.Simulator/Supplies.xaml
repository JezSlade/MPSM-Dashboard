<Window x:Class="MpsMonitor.Sdk.Simulator.Supplies"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MpsMonitor.Sdk.Simulator"
        mc:Ignorable="d"
        Title="Supplies" Height="650" Width="800">
   <Border Padding="10" ScrollViewer.CanContentScroll="True">
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"  >
         <StackPanel ScrollViewer.CanContentScroll="True" VerticalAlignment="Top">
            <StackPanel>
               <!-- label -->
               <StackPanel  Grid.Column="0" Margin="0 0 10 0">
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <!-- label Dealse -->
                     <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock  x:Name="lblDealer" Text="Dealer" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="txtDealer" Padding="2" IsReadOnly="True" Background="LightGray" />
                     </StackPanel>

                     <!-- PartNumber -->
                     <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock  Text="Part Number" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="txtPartNumber" Padding="2"  />
                     </StackPanel>
                  </Grid>
                  
                  <!--GRid 2-->
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                     </Grid.RowDefinitions>
                     <!--Description-->
                     <StackPanel Grid.Column="0"  Margin="0 0 10 0">
                        <TextBlock Text="Description" FontWeight="Bold" Margin="0 10 0 5"/>
                        <TextBox x:Name="txtDescription" Padding="2" />
                     </StackPanel>
                     <!--Type-->
                     <StackPanel Grid.Column="1"  Margin="0 0 10 0">
                        <TextBlock Text="Type" FontWeight="Bold" Margin="0 10 0 5"/>
                        <ComboBox x:Name="cmbType" Padding="2"  SelectionChanged="CmbType_SelectionChanged"/>
                     </StackPanel>
                     <!--Color-->
                     <StackPanel Grid.Column="2"  Margin="0 0 10 0">
                        <TextBlock Text="Color" FontWeight="Bold" Margin="0 10 0 5"/>
                        <ComboBox x:Name="cmbColor" Padding="2" />
                     </StackPanel>
                     <!--Duration-->
                     <StackPanel Grid.Column="3"  Margin="0 0 10 0">
                        <TextBlock Text="Duration" FontWeight="Bold" Margin="0 10 0 5"/>
                        <TextBox x:Name="txtDuration" Padding="2" PreviewTextInput="NumberValidationTextBox" />
                     </StackPanel>
                  </Grid>

                  <!--GRid 3-->
                  <Grid x:Name="gridMantenanceKit">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                     </Grid.RowDefinitions>
                     <!--Maintenance Kit Type-->
                     <StackPanel Grid.Column="0"  Margin="0 0 10 0">
                        <TextBlock Text="Maintenance Kit Type" FontWeight="Bold" Margin="0 10 0 5"/>
                        <ComboBox x:Name="cmbMaintenanceKitType" Padding="2" />
                     </StackPanel>
                     <!--MaintenanceKitColor-->
                     <StackPanel Grid.Column="1"  Margin="0 0 10 0">
                        <TextBlock Text="MaintenanceKit Color" FontWeight="Bold" Margin="0 10 0 5"/>
                        <ComboBox x:Name="cmbMaintenanceKitColor" Padding="2" />
                     </StackPanel>
                   
                  </Grid>

               </StackPanel>
               <!-- btn Save-->
               <StackPanel Grid.Column="1" Margin="0 10 10 0">
                  <Button x:Name="btnSave" Content="Save" Margin="0 5 0 5" Click="BtnSave_Click"></Button>
               </StackPanel>
            </StackPanel>

            <!-- Result Panel -->
            <StackPanel>
               <TabControl x:Name="tabResult" Margin="0 15 0 0">
                  <TabItem Header="Response">
                     <TextBox x:Name="ResponseBox" Padding="2"  Text="" Height="250"  IsReadOnly="True" Background="LightGray" ScrollViewer.CanContentScroll="True" UseLayoutRounding="True" VerticalScrollBarVisibility="Auto"/>
                  </TabItem>
                  <TabItem Header="Request">
                     <TextBox x:Name="RequestBox" Padding="2"  Text="" Height="250"  IsReadOnly="True" Background="LightGray" ScrollViewer.CanContentScroll="True" UseLayoutRounding="True" VerticalScrollBarVisibility="Auto"/>
                  </TabItem>
               </TabControl>
            </StackPanel>
         </StackPanel>
      </ScrollViewer>
   </Border>
</Window>
