<Window x:Class="MpsMonitor.Sdk.Simulator.Offices"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MpsMonitor.Sdk.Simulator"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Offices"  Height="708" Width="800">
   <Border Padding="10" ScrollViewer.CanContentScroll="True">
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"  >
         <StackPanel ScrollViewer.CanContentScroll="True" VerticalAlignment="Top">
            <wpfx:BusyIndicator x:Name="_busyIndicator">
               <StackPanel>
               <StackPanel Margin="10 0 10 0">
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <!-- label -->
                     <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <Grid>
                           <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <!-- label Dealse -->
                           <StackPanel Grid.Column="0" Margin="0 0 10 0">
                              <TextBlock  x:Name="lblDealer" FontWeight="Bold" Margin="0 15 0 5"/>
                           </StackPanel>

                           <!-- lblCustomer -->
                           <StackPanel Grid.Column="1" Margin="0 0 10 0">
                              <TextBlock x:Name="lblCustomer" FontWeight="Bold" Margin="0 15 0 5"/>
                           </StackPanel>
                        </Grid>
                     </StackPanel>

                     <!-- btnAddOffice -->
                     <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <Button x:Name="btnAddOffice" Content="Add Office" Margin="0 15 0 5" Click="BtnAddOffice_Click"></Button>
                     </StackPanel>
                  </Grid>


               </StackPanel>
               <!--1 row-->
               <StackPanel>
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <!-- Codice -->
                     <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Code" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="Code" Padding="2" IsEnabled="False"/>
                     </StackPanel>
                     <!-- Descrizione -->
                     <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Description" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="Description" Padding="2" />
                     </StackPanel>

                     <!-- Indirizzo -->
                     <StackPanel Grid.Column="2" Margin="0 0 10 0">
                        <TextBlock Text="Address" FontWeight="Bold" Margin="0 15 0 5" />
                        <TextBox x:Name="Address" Padding="2"  />
                     </StackPanel>
                     <!-- City -->
                     <StackPanel Grid.Column="3" Margin="0 0 10 0">
                        <TextBlock Text="City" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="City" Padding="2"   />
                     </StackPanel>

                  </Grid>
               </StackPanel>
               <!--2 row-->
               <StackPanel>
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <!-- ZipCode -->
                     <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="ZipCode" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="ZipCode" Padding="2"/>
                     </StackPanel>
                     <!-- Country -->
                     <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Country" FontWeight="Bold" Margin="0 15 0 5"/>
                        <ComboBox x:Name="cmbCountry" Padding="2" SelectedIndex="0" ></ComboBox>
                     </StackPanel>
                     <!-- Province -->
                     <StackPanel Grid.Column="2" Margin="0 0 10 0">
                        <TextBlock Text="Province" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="Province" Padding="2"  />
                     </StackPanel>
                     <!-- MailAddress -->
                     <StackPanel Grid.Column="3" Margin="0 0 10 0">
                        <TextBlock Text="Mail Address" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="MailAddress" Padding="2"  />
                     </StackPanel>
                     <!-- Telephone -->
                     <StackPanel Grid.Column="4" Margin="0 0 10 0">
                        <TextBlock Text="Telephone" FontWeight="Bold" Margin="0 15 0 5" />
                        <TextBox x:Name="Telephone" Padding="2"   />
                     </StackPanel>
                     <!-- Fax -->
                     <StackPanel Grid.Column="5" Margin="0 0 10 0">
                        <TextBlock Text="Fax" FontWeight="Bold" Margin="0 15 0 5" />
                        <TextBox x:Name="Fax" Padding="2"   />
                     </StackPanel>
                  </Grid>
               </StackPanel>
               <!--3 row-->
               <StackPanel>
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />

                     </Grid.ColumnDefinitions>

                     <!-- sede 1 -->
                     <!--
                  <StackPanel Grid.Column="0" Margin="0 0 10 0">
                     <TextBlock Text="Sede 1" FontWeight="Bold" Margin="0 15 0 5"/>
                     <TextBox x:Name="SedeOne" Padding="2"  />
                  </StackPanel>
                  -->
                     <!-- sede 2 -->
                     <!--
                  <StackPanel Grid.Column="1" Margin="0 0 10 0">
                     <TextBlock Text="Sede 2" FontWeight="Bold" Margin="0 15 0 5"/>
                     <TextBox x:Name="SedeTwo" Padding="2"   />
                  </StackPanel>-->

                  </Grid>
               </StackPanel>
               <!--4 row-->
               <StackPanel>
                  <Grid Height="120">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>
                     <!-- Note -->
                     <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Note" FontWeight="Bold" Margin="0 15 0 5"/>
                        <TextBox x:Name="Note" Padding="2" Height="80" />
                     </StackPanel>


                  </Grid>
               </StackPanel>
               <!--5 row-->
               <StackPanel Margin="10 0 10 0">
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                     </Grid.ColumnDefinitions>

                     <!-- Importa automaticamente le stampanti di questa sede -->
                     <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Automatically import printers from this location" FontWeight="Bold" Margin="0 15 0 5"/>
                        <CheckBox x:Name="EnableAutoAssign" ></CheckBox>
                     </StackPanel>
                     <!-- btnSave -->
                     <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="" FontWeight="Bold" Margin="0 15 0 5"/>
                        <Button x:Name="btnSave" Content="Save" Click="BtnSave_Click"></Button>
                     </StackPanel>
                  </Grid>


               </StackPanel>
               <!-- Result Panel -->
               <StackPanel>
                  <TabControl x:Name="tabResult" Margin="0 15 0 0">
                     <TabItem Header="Response">
                        <TextBox x:Name="ResponseBox" Padding="2"  Text="" Height="250"  IsReadOnly="True" Background="LightGray" ScrollViewer.CanContentScroll="True" UseLayoutRounding="True" VerticalScrollBarVisibility="Auto"/>
                     </TabItem>
                     <TabItem Header="Request">
                        <TextBox x:Name="RequestBox" Padding="2"  Text="" Height="250"  IsReadOnly="True" Background="LightGray" ScrollViewer.CanContentScroll="True" UseLayoutRounding="True" VerticalScrollBarVisibility="Auto"/>
                     </TabItem>
                  </TabControl>
               </StackPanel>
               </StackPanel>
            </wpfx:BusyIndicator>
         </StackPanel>
      </ScrollViewer>
   </Border>
</Window>
