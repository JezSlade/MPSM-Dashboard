{
  "version": "1.0",
  "description": "Machine-ingestible pipeline for MPS Monitor API endpoints. Dealer-centric flow with prereqs for IDs.",
  "base_url": "https://localhost:34287",
  "schemes": [
    "https"
  ],
  "authentication": {
    "required": true,
    "note": "Most endpoints require authentication. Use /Account/GetProfile to verify. Login assumed external."
  },
  "common_prereqs": {
    "get_dealers": {
      "endpoint": "/Account/GetAccounts",
      "method": "POST",
      "payload_template": {
        "request": {
          "$ref": "#/definitions/GetAccountsRequest"
        }
      },
      "output_key": "accounts",
      "validation": "Extract dealerCode and Id from AccountDto"
    },
    "get_customers": {
      "endpoint": "/Customer/List",
      "method": "POST",
      "payload_template": {
        "request": {
          "DealerId": "{{prereqs.get_dealers.accounts[0].Id}}",
          "$ref": "#/definitions/GetCustomersRequest"
        }
      },
      "output_key": "customers",
      "validation": "Verify customers belong to selected dealer"
    }
  },
  "flow_template": {
    "steps": [
      {
        "step": "authenticate",
        "description": "Ensure valid session"
      },
      {
        "step": "prereqs",
        "if": "requires_dealer_id or requires_customer_id",
        "actions": [
          "get_dealers",
          "get_customers"
        ]
      },
      {
        "step": "validate_prereqs",
        "description": "Check IDs are valid and match"
      },
      {
        "step": "compose_payload",
        "description": "Fill required fields from prereqs, e.g., dealerCode: {{prereqs.get_dealers.accounts[0].Code}}, customerId: {{prereqs.get_customers.customers[0].Id}}"
      },
      {
        "step": "call_endpoint",
        "description": "Invoke target endpoint with composed payload"
      },
      {
        "step": "validate_response",
        "description": "Check IsValid true, no Errors"
      }
    ]
  },
