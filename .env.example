APP_NAME="MPS Monitor Dashboard"
APP_VERSION=3.0.0
APP_ENV=production
APP_DEBUG=false
APP_KEY=change-me
TIMEZONE=America/New_York

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
DB_PREFIX=mpsm_

MPS_API_BASE=https://api.abassetmanagement.com/api3/
MPS_API_TOKEN_URL=https://api.abassetmanagement.com/api3/token
MPS_CLIENT_ID=
MPS_CLIENT_SECRET=
MPS_USERNAME=
MPS_PASSWORD=
MPS_SCOPE=

CACHE_DRIVER=database
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

API_RATE_LIMIT=false
FEATURE_DEVICE_CRUD=true
FEATURE_MULTI_TENANCY=false
FEATURE_WEBSOCKETS=false
FEATURE_JOB_QUEUE=false

DEFAULT_DEALER_CODE=
DEFAULT_DEALER_ID=
DEFAULT_CUSTOMER_CODE=
DEFAULT_CUSTOMER_ID=
DEFAULT_CUSTOMER_NAME=
LOG_LEVEL=info
