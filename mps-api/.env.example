# MPS Monitors API Engine Configuration
# Copy this file to .env and fill in your credentials

# MPSM API Base URL
API_BASE_URL=https://api.mpsmonitors.com
TOKEN_URL=https://api.mpsmonitors.com/oauth/token

# OAuth 2.0 Credentials (Password Grant)
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
USERNAME=your_username_here
PASSWORD=your_password_here

# Dealer Information (for auto-population - Fix #2)
DEALER_CODE=YOUR_DEALER_CODE
DEALER_ID=12345

# Debug Mode (set to false in production)
MPS_DEBUG=true

# Request Timeouts (seconds)
MPS_TIMEOUT=30
MPS_CONNECT_TIMEOUT=10

# Optional: Override default behavior
# MPS_RETRY_ATTEMPTS=3
# MPS_RETRY_DELAY=1000
